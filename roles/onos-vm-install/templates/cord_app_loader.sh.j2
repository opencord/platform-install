#!/usr/bin/env bash
# onos-vm-install/templates/cord_loader.sh.j2
# loads/activates .oar CORD app files into ONOS instance

source /root/.bashrc

{% for cord_app in cord_apps %} 
onos-app {{ onos_vm_hostname }} install  /root/apps/{{ cord_app.name }}.oar
onos-app {{ onos_vm_hostname }} activate {{ cord_app.onos_name }}
{% endfor %}

