# Created by platform-install: interface-config/templates/eth.cfg.j2

{% for node in physical_node_list if node.name == ansible_hostname %}
auto {{ node.interface | default(host_net_management_interface) }}
{% set host_link_ip = ( host_net_management_cidr | ipaddr(node.ipv4_last_octet) | ipaddr('address')) %}
iface {{ node.interface | default(host_net_management_interface) }} inet static
    address {{ host_link_ip }}
    network {{ host_net_management_cidr | ipaddr('network') }}
    netmask {{ host_net_management_cidr | ipaddr('netmask') }}
    broadcast {{ host_net_management_cidr | ipaddr('broadcast') }}
{% if node.gateway_enabled is defined and node.gateway_enabled %}
    gateway {{ host_net_management_cidr | ipaddr('1') }}
{% endif %}

{% endfor %}
