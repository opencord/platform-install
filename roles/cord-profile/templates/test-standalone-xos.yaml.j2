tosca_definitions_version: tosca_simple_yaml_1_0

description: Onboard XOS

imports:
   - custom_types/xos.yaml

topology_template:
  node_templates:
    xos:
      type: tosca.nodes.XOS
      properties:
        ui_port: {{ xos_ui_port }}
        bootstrap_ui_port: {{ xos_bootstrap_ui_port }}
        docker_project_name: teststandalone
        db_container_name: teststandalonebs_xos_db_1
        frontend_only: true
        source_ui_image: xosproject/xos-test

    /opt/xos/core/xos_common_config:
      type: tosca.nodes.XOSVolume
      properties:
          host_path: {{ cord_dir }}/{{ cord_profile }}/xos_common_config
          read_only: false
      requirements:
          - xos:
             node: xos
             relationship: tosca.relationships.UsedByXOS

    /opt/xos/api/utility:
      type: tosca.nodes.XOSVolume
      properties:
          host_path: {{ cord_dir }}/orchestration/xos/xos/api/utility
          read_only: false
      requirements:
          - xos:
             node: xos
             relationship: tosca.relationships.UsedByXOS

    /opt/xos/tests:
      type: tosca.nodes.XOSVolume
      properties:
          host_path: {{ cord_dir }}/orchestration/xos/xos/tests
          read_only: false
      requirements:
          - xos:
             node: xos
             relationship: tosca.relationships.UsedByXOS

