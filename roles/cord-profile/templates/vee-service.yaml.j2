tosca_definitions_version: tosca_simple_yaml_1_0

imports:
   - custom_types/xos.yaml
   - custom_types/vee.yaml

description: vee services, generated by platform-install

topology_template:
  node_templates:

    service#ONOS_VEE:
      type: tosca.nodes.ONOSService
      requirements:
      properties:
          kind: onos
          view_url: /admin/onos/onosservice/$id$/
          no_container: true
          rest_hostname: onos-fabric # (?)
          replaces: service_ONOS_Fabric # (?)
          rest_onos/v1/network/configuration/: { get_artifact: [ SELF, fabric_network_cfg_json, LOCAL_FILE ] } # needed?
      artifacts: # needed?
          fabric_network_cfg_json: {{ fabric_network_cfg_json }} # needed?

    service#vEE:
      type: tosca.nodes.vEEService
      properties:
          view_url: /admin/vEE/fabricservice/$id$/
          replaces: service_fabric

    CarrierEthernet_ONOS_app:
      type: tosca.nodes.ONOSApp
      requirements:
          - onos_tenant:
              node: service#ONOS_VEE
              relationship: tosca.relationships.TenantOfService
          - vee_service:
              node: service#fabric
              relationship: tosca.relationships.UsedByService
      properties:
          dependencies: org.onosproject.drivers, org.onosproject.openflow-base, org.onosproject.ecord.carrierethernet

