tosca_definitions_version: tosca_simple_yaml_1_0

description: TOSCA to setup OpenCloud services, created by platform-install

imports:
   - custom_types/xos.yaml
   - custom_types/addressmanager.yaml

topology_template:
  node_templates:

{% set public_gateway_ip = ( vtn_net_public_cidr | ipaddr('1') | ipaddr('address')) %}
    addresses_public:
      type: tosca.nodes.AddressPool
      properties:
        addresses: "{{ vtn_net_public_cidr }}"
        gateway_ip: "{{ public_gateway_ip }}"
        gateway_mac: "{{ ( vtn_net_public_hwaddr_prefix ~ ( public_gateway_ip | ip4_hex )) | hwaddr('unix') }}"

    service#addressmanager:
      type: tosca.nodes.AddressManagerService
      requirements:
        - addresses_public:
            node: addresses_public
            relationship: tosca.relationships.ProvidesAddresses

