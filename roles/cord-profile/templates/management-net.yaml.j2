---
tosca_definitions_version: tosca_simple_yaml_1_0

imports:
   - custom_types/xos.yaml

description: management network config, generated by platform-install

topology_template:
  node_templates:

# site, fully created in deployment.yaml
    {{ site_name }}:
      type: tosca.nodes.Site

# management (vtn: MANAGEMENT_LOCAL) network
    management_local_template:
      type: tosca.nodes.NetworkTemplate
      properties:
        visibility: private
        translation: none
        vtn_kind: MANAGEMENT_LOCAL

    {{ site_name }}_management:
      description: This slice exists solely to own the management network
      type: tosca.nodes.Slice
      properties:
        network: noauto
      requirements:
        - site:
            node: {{ site_name }}
            relationship: tosca.relationships.MemberOfSite

    management:
      type: tosca.nodes.network.Network
      properties:
        ip_version: 4
        cidr: {{ vtn_net_management_local_cidr }}
      requirements:
        - network_template:
            node: management_local_template
            relationship: tosca.relationships.UsesNetworkTemplate
        - owner:
            node: {{ site_name }}_management
            relationship: tosca.relationships.MemberOfSlice

{% if use_vtn_net_management_host %}
# management_host (vtn: MANAGEMENT_HOST) network
    management_host_template:
      type: tosca.nodes.NetworkTemplate
      properties:
        visibility: private
        translation: none
        vtn_kind: MANAGEMENT_HOST

    management_host:
      type: tosca.nodes.network.Network
      properties:
        ip_version: 4
        cidr: {{ vtn_net_management_host_cidr }}
        start_ip: {{ vtn_net_management_host_range_xos_low }}
        end_ip: {{ vtn_net_management_host_net_range_xos_high }}
      requirements:
        - network_template:
            node: management_host_template
            relationship: tosca.relationships.UsesNetworkTemplate
        - owner:
            node: {{ site_name }}_management
            relationship: tosca.relationships.MemberOfSlice
{% endif %}


