tosca_definitions_version: tosca_simple_yaml_1_0

imports:
   - custom_types/xos.yaml
   - custom_types/metronet.yaml

description: vnodglobal services, generated by platform-install

topology_template:
    node_templates:

      bandwidthprofile#bronze:
        type: tosca.nodes.EcordBandwidthProfile
        requirements:
        properties:
          bwpcfgcbs: 1000
          bwpcfgebs: 1200
          bwpcfgcir: 1000000
          bwpcfgeir: 1200000
          name: bronze

      bandwidthprofile#silver:
        type: tosca.nodes.EcordBandwidthProfile
        requirements:
        properties:
          bwpcfgcbs: 1500
          bwpcfgebs: 2000
          bwpcfgcir: 1500000
          bwpcfgeir: 2000000
          name: silver

      bandwidthprofile#gold:
        type: tosca.nodes.EcordBandwidthProfile
        requirements:
        properties:
          bwpcfgcbs: 2000
          bwpcfgebs: 2700
          bwpcfgcir: 2000000
          bwpcfgeir: 2700000
          name: gold

      bandwidthprofile#platinum:
        type: tosca.nodes.EcordBandwidthProfile
        requirements:
        properties:
          bwpcfgcbs: 2500
          bwpcfgebs: 3200
          bwpcfgcir: 2500000
          bwpcfgeir: 3200000
          name: platinum

      usernetworkinterface#UserNetworkInterface1:
        type: tosca.nodes.EcordUserNetworkInterface
        requirements:
        properties:
            enabled: true
            capacity: 10000000
            bw_used: 50000
            vlanIds: [100,200,300]
            name: uni1
            location: San Rafael
            latlng: [37.973535, -122.531087]
            cpe: netconf:192.168.56.10:830/0

      usernetworkinterface#UserNetworkInterface2:
        type: tosca.nodes.EcordUserNetworkInterface
        requirements:
        properties:
            enabled: true
            capacity: 10000000
            bw_used: 50000
            vlanIds: [100,200,300]
            name: uni2
            location: San Francisco
            latlng: [37.773972, -122.431297]
            cpe: netconf:192.168.56.20:830/0

      service#vnodglobal:
        type: tosca.nodes.VNodGlobalService
        requirements:
          - bandwith_profile:
              node: bandwidthprofile#platinum
              relationship: tosca.relationships.UsesBandwidthProfile
        properties: