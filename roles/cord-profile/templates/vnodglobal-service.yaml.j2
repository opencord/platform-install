tosca_definitions_version: tosca_simple_yaml_1_0

imports:
   - custom_types/xos.yaml
   - custom_types/metronet.yaml

description: vnodglobal services, generated by platform-install

topology_template:
    node_templates:

      bandwidthprofile#ecordbandwithprofile:
        type: tosca.nodes.EcordBandwithProfile
        requirements:
        properties:
          committed_burst_size: 100
          excess_burst_size: 50
          committed_information_rate: 600
          excess_information_rate: 50
          name: test-bp


      service#vnodglobal:
        type: tosca.nodes.VNodGlobalService
        requirements:
          - bandwith_profile:
              node: bandwidthprofile#ecordbandwithprofile
              relationship: tosca.relationships.UsesBandwidthProfile
        properties: