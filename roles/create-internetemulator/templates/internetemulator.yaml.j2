tosca_definitions_version: tosca_simple_yaml_1_0

imports:
   - custom_types/xos.yaml
   - custom_types/slice.yaml
   - custom_types/network.yaml
   - custom_types/networkslice.yaml
   - custom_types/internetemulatorservice.yaml
   - custom_types/internetemulatorserviceinstance.yaml

description: configure an internetemulatorserviceinstance

topology_template:
  node_templates:

    management_network:
      type: tosca.nodes.Network
      properties:
        must-exist: true
        name: management

    sgi_network:
      type: tosca.nodes.Network
      properties:
        must-exist: true
        name: sgi_network

    {{ site_name }}_internetemulator:
      type: tosca.nodes.Slice
      properties:
          name: {{ site_name }}_internetemulator
          must-exist: true

    internetemulator_slice_management_network:
      type: tosca.nodes.NetworkSlice
      requirements:
        - network:
            node: management_network
            relationship: tosca.relationships.BelongsToOne
        - slice:
            node: {{ site_name }}_internetemulator
            relationship: tosca.relationships.BelongsToOne

    internetemulator_slice_sgi_network:
      type: tosca.nodes.NetworkSlice
      requirements:
        - network:
            node: sgi_network
            relationship: tosca.relationships.BelongsToOne
        - slice:
            node: {{ site_name }}_internetemulator
            relationship: tosca.relationships.BelongsToOne

    internetemulator_service:
      type: tosca.nodes.InternetEmulatorService
      properties:
        name: internetemulator_service

    internetemulator_serviceinstance:
      type: tosca.nodes.InternetEmulatorServiceInstance
      properties:
        name: VLC video server
      requirements:
        - owner:
            node: internetemulator_service
            relationship: tosca.relationships.BelongsToOne
